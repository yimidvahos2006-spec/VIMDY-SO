{
  "name": "vimdy-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "release:guards": "node scripts/release-guards.mjs",
    "clean": "node scripts/clean-workspace.mjs",
    "clean:apply": "node scripts/clean-workspace.mjs --apply",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2",
    "tesseract.js": "^5.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "tinypool": "2.1.2"
  }
}
