# Supabase configuration
# Obtén estos valores en tu panel de Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tu-anon-key-publica

# URL pública de la aplicación (donde el usuario accede a VIMDY)
VITE_APP_URL=https://app.vimdy.co

# --- Email delivery (Supabase Auth SMTP) ---
# RESEND_SMTP_PASS es REQUERIDO para que Supabase Auth envíe correos:
#   - Códigos OTP de 6 dígitos (registro, login por código)
#   - Links de recuperación de contraseña
# Sin esta variable, Supabase no envía ningún email y el usuario se queda
# bloqueado. La config local está en supabase/config.toml -> [auth.email.smtp].
# Crea una API key en https://resend.com/api-keys y pégala aquí.
RESEND_SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email delivery for VIMDY daily reports ---
# La Edge Function process-daily-report usa estas variables para enviar
# cierres diarios y correos de prueba al destinatario configurado en Ajustes.
# No las expongas en el frontend. Configúralas como secrets de Supabase.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=VIMDY <notificaciones@tu-dominio-verificado.com>

# --- Google OAuth (opcional) ---
# Si estos valores no están configurados, el botón "Continuar con Google"
# mostrará un error amigable y el usuario usará correo/contraseña u OTP.
# Configura una app OAuth en Google Cloud Console y pega las credenciales aquí.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# VIMDY — Reporte inteligente por WhatsApp
# El template FULL_REPORT debe tener un único placeholder {{1}} en el body.
WHATSAPP_DAILY_REPORT_TEMPLATE_MODE=FULL_REPORT
WHATSAPP_DAILY_REPORT_TEMPLATE=<template_aprobada_por_Meta>
WHATSAPP_DAILY_REPORT_LANGUAGE=es_CO

# La Edge Function reutiliza la misma clave Anthropic del Copiloto para redactar el mensaje corto.
DAILY_REPORT_AI_MODEL=claude-sonnet-5